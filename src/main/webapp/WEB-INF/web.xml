<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://xmlns.jcp.org/xml/ns/javaee
            http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>OSRM Integration</display-name>

    <!-- ✅ Jersey Servlet Configuration (Tomcat 9 / javax) -->
    <servlet>
        <servlet-name>JerseyREST</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>

        <init-param>
            <!-- ✅ MUST BE javax, NOT jakarta -->
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>uk.ac.ntu.part_b.JakartaRestConfiguration</param-value>
        </init-param>

        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>JerseyREST</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

</web-app>
